<%- include('partials/header') %>

<section class="page-header">
  <h2>Admissions</h2>
</section>

<section class="content-section">
  <h3>Admission Process</h3>
  <ol>
    <li>Obtain an application form from the school office or download online</li>
    <li>Submit completed form with required documents</li>
    <li>Attend entrance assessment (where applicable)</li>
    <li>Receive admission letter</li>
    <li>Complete registration and pay fees</li>
  </ol>

  <h3>Required Documents</h3>
  <ul>
    <li>Birth certificate</li>
    <li>Passport photographs (4 copies)</li>
    <li>Immunization records</li>
    <li>Previous school report (for transfers)</li>
  </ul>

  <h3>Classes Available</h3>
  <ul>
    <li>Creche (3 months - 2 years)</li>
    <li>Pre-Nursery (2-3 years)</li>
    <li>Nursery 1 & 2 (3-5 years)</li>
    <li>Primary 1 - 6 (5-12 years)</li>
  </ul>

  <a href="/contact" class="btn">Apply Now</a>
</section>

<%- include('partials/footer') %>